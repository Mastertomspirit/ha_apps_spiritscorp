#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG_FILE="/run/mimir/healthcheck.conf"

[ -r "${CONFIG_FILE}" ] || exit 1
. "${CONFIG_FILE}"

if [ "${SCHEME}" = "https" ]; then
    exec curl -S -s -f  \
        --max-time 5 \
        --cacert "${CA_FILE}" \
        --resolve "${SERVER_NAME}:${PORT}:${ADDRESS}" \
        "https://${SERVER_NAME}:${PORT}/ready" \
        >/dev/null 2>&1
else

    exec curl -k -s -f  \
        --max-time 5 \
        "http://${ADDRESS}:${PORT}/ready" \
       >/dev/null 2>&1
fi
